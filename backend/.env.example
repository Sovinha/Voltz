# Supabase Credentials
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-ou-service-role

# Configurações do Flask Server
FLASK_PORT=5000
FLASK_DEBUG=True

# Chave API do DeepSeek AI
DEEPSEEK_API_KEY=sua-chave-api-deepseek

# Google Maps Geocoding API Key (OPCIONAL — ativa precisão máxima de porta/número)
# Crie em: https://console.cloud.google.com/apis/credentials
# Google oferece $200/mês gratuitos (~40.000 geocodificações/mês)
GOOGLE_MAPS_API_KEY=

# Servidor de Roteamento OSRM (Project-OSRM v5)
# Exemplo padrao (servidor publico): https://router.project-osrm.org
# Exemplo self-hosted em Docker: http://localhost:5000 ou IP do seu servidor OSRM local
OSRM_BASE_URL=https://router.project-osrm.org
